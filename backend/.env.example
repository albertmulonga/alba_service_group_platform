# Provide these values through your environment when running account setup scripts.
ALBA_ADMIN_PASSWORD=
ALBA_SEED_ADMIN_PASSWORD=
ALBA_SEED_COMPTABLE_PASSWORD=
ALBA_SEED_IMPRIMERIE_PASSWORD=
ALBA_SEED_GRAPHISTE_PASSWORD=
ALBA_SEED_SECRETAIRE_PASSWORD=
ALBA_SEED_DEVELOPPEUR_PASSWORD=
ALBA_SEED_FORMATEUR_PASSWORD=
ALBA_SEED_TECHNICIEN_PASSWORD=
ALBA_SEED_CAISSIER_PASSWORD=

# PostgreSQL connection for the NestJS API.
# Local development: use your local PostgreSQL URL.
# Neon runtime: use the pooled connection URL in the backend host's environment.
# For Prisma migrations, use the direct (non-pooled) Neon URL as DATABASE_URL.
DATABASE_URL=

# Comma-separated web origins allowed to call the API (no trailing slashes).
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# SMTP email delivery (leave empty until a professional mail provider is configured)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Meta WhatsApp Business Cloud API (leave empty until approved credentials are configured)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v22.0
NOTIFICATIONS_WORKER_ENABLED=true

# Daily and weekly stock report schedule (local company time)
STOCK_REPORT_WORKER_ENABLED=true
STOCK_REPORT_TIMEZONE=Africa/Lubumbashi
STOCK_REPORT_HOUR=8

# WebAuthn for employee attendance (use the exact public web origin and host).
# Local development should use http://localhost:3000, not 127.0.0.1.
WEBAUTHN_RP_NAME=ALBA SERVICE GROUP
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:3000
